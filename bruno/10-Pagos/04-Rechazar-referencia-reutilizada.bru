meta {
  name: Rechazar referencia reutilizada
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/pagos/efectivo
  body: json
  auth: bearer
}

auth:bearer {
  token: {{operadorToken}}
}

body:json {
  {"cobroId":"00000000-0000-4000-8000-000000000001","referencia":"{{referenciaPago}}"}
}

script:pre-request {
    if (bru.getEnvVar("baseUrl") !== "http://localhost:3001") {
      throw new Error("Ejecutar solo en el entorno aislado PARQ-41");
    }
}

tests {
  test("HTTP 409", function () {
    expect(res.getStatus()).to.equal(409);
  });

  test("Contrato de error HTTP", function () {
    const body = res.getBody();
    expect(body.statusCode).to.equal(409);
    expect(body).to.have.property("message");
    expect(body).to.have.property("path");
    expect(body).to.have.property("timestamp");
  });
}
