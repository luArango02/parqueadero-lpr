meta {
  name: Rechazar cobro inexistente
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/pagos/efectivo
  body: json
  auth: bearer
}

auth:bearer {
  token: {{operadorToken}}
}

body:json {
  {"cobroId":"00000000-0000-4000-8000-000000000001","referencia":"{{referenciaPago}}-INEXISTENTE"}
}

script:pre-request {
    if (bru.getEnvVar("baseUrl") !== "http://localhost:3001") {
      throw new Error("Ejecutar solo en el entorno aislado PARQ-41");
    }
}

tests {
  test("HTTP 404", function () {
    expect(res.getStatus()).to.equal(404);
  });

  test("Contrato de error HTTP", function () {
    const body = res.getBody();
    expect(body.statusCode).to.equal(404);
    expect(body).to.have.property("message");
    expect(body).to.have.property("path");
    expect(body).to.have.property("timestamp");
  });
}
