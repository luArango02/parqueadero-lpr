meta {
  name: Consultar pase vigente
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/pases/{{placaCarro}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{operadorToken}}
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Pase vigente", function() {
    expect(res.getBody().vigente).to.equal(true);
  });

  test("Cobro pagado", function() {
    expect(res.getBody().estadoCobro).to.equal("PAGADO");
  });

  test("Mismo cobro del ingreso", function() {
    expect(res.getBody().cobroId)
      .to.equal(bru.getVar("cobroId"));
  });

  test("Placa correcta", function() {
    expect(res.getBody().placa)
      .to.equal(bru.getVar("placaCarro"));
  });
}
