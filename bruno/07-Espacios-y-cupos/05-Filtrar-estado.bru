meta {
  name: Filtrar espacios disponibles
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/espacios?estado=DISPONIBLE
  body: none
  auth: none
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Existen resultados", function() {
    expect(res.getBody().length).to.be.greaterThan(0);
  });

  test("Filtro aplicado correctamente", function() {
    expect(res.getBody().every(
      e => e.estado === "DISPONIBLE"
    )).to.equal(true);
  });
}
