meta {
  name: Filtrar espacios por zona
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/espacios?zona=A
  body: none
  auth: none
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Existen resultados", function() {
    expect(res.getBody().length).to.be.greaterThan(0);
  });

  test("Filtro aplicado correctamente", function() {
    expect(res.getBody().every(
      e => e.zona === "A"
    )).to.equal(true);
  });
}
