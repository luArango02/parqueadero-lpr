meta {
  name: Filtrar espacios compatibles con moto
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/espacios?tipo=MOTO
  body: none
  auth: none
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Existen resultados", function() {
    expect(res.getBody().length).to.be.greaterThan(0);
  });

  test("Filtro aplicado correctamente", function() {
    expect(res.getBody().every(
      e => e.tipoCompatible === "MOTO"
    )).to.equal(true);
  });
}
