meta {
  name: Consultar disponibilidad agrupada por zona
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/espacios/disponibilidad
  body: none
  auth: none
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Respuesta de tipo arreglo", function() {
    expect(res.getBody()).to.be.an("array");
  });

  test("Zona A para carros", function() {
    expect(res.getBody().some(
      z => z.zona === "A" && z.tipo === "CARRO"
    )).to.equal(true);
  });

  test("Zona M para motos", function() {
    expect(res.getBody().some(
      z => z.zona === "M" && z.tipo === "MOTO"
    )).to.equal(true);
  });

  test("Conteos consistentes", function() {
    expect(res.getBody().every(z =>
      z.total === z.disponibles +
                 z.ocupados +
                 z.fueraDeServicio
    )).to.equal(true);
  });

  test("Indicador lleno consistente", function() {
    expect(res.getBody().every(
      z => z.lleno === (z.disponibles === 0)
    )).to.equal(true);
  });
}
