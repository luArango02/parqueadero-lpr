meta {
  name: Impedir modificacion de espacio ocupado
  type: http
  seq: 24
}

patch {
  url: {{baseUrl}}/api/espacios/{{espacioOcupadoId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
{"estado":"FUERA_DE_SERVICIO"}
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:3001") {
    throw new Error("Ejecutar solo en el entorno aislado PARQ-41");
  }
}

tests {
  test("HTTP 409", function() {
    expect(res.getStatus()).to.equal(409);
  });

  test("Conflicto documentado", function() {
    expect(res.getBody().statusCode).to.equal(409);
  });

  test("Motivo de ocupacion informado", function() {
    expect(res.getBody().message).to.include("ocupado");
  });
}
