meta {
  name: Poner espacio fuera de servicio
  type: http
  seq: 13
}

patch {
  url: {{baseUrl}}/api/espacios/{{espacioPruebaId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
{"estado":"FUERA_DE_SERVICIO"}
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:3001") {
    throw new Error("Ejecutar solo en el entorno aislado PARQ-41");
  }
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Estado actualizado", function() {
    expect(res.getBody().estado)
      .to.equal("FUERA_DE_SERVICIO");
  });

  test("Identificador conservado", function() {
    expect(res.getBody().id)
      .to.equal(bru.getVar("espacioPruebaId"));
  });

  test("Codigo conservado", function() {
    expect(res.getBody().codigo)
      .to.equal(bru.getVar("codigoEspacioPrueba"));
  });
}
