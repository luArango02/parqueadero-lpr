meta {
  name: Rechazar codigo duplicado
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/espacios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
{"zona":"Z","numero":{{numeroEspacioPrueba}},"tipoCompatible":"CARRO"}
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:3001") {
    throw new Error("Ejecutar solo en el entorno aislado PARQ-41");
  }
}

tests {
  test("HTTP 409", function() {
    expect(res.getStatus()).to.equal(409);
  });

  test("Contrato de error correcto", function() {
    expect(res.getBody().statusCode).to.equal(409);
  });
}
