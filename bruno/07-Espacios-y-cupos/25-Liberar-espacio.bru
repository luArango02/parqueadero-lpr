meta {
  name: Liberar espacio mediante salida de motocicleta
  type: http
  seq: 25
}

post {
  url: {{baseUrl}}/api/accesos/salida
  body: json
  auth: none
}

body:json {
  {
    "placa": "{{placaMotoEspacio}}",
    "confianza": 0.98,
    "carrilId": "{{carrilSalidaId}}"
  }
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:3001") {
    throw new Error("Ejecutar solo en el entorno aislado PARQ-41");
  }
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Salida autorizada", function() {
    expect(res.getBody().autorizado).to.equal(true);
  });

  test("Espacio liberado correctamente", function() {
    expect(res.getBody().espacioLiberado)
      .to.equal(bru.getVar("codigoEspacioOcupado"));
  });

  test("Sin cobros pendientes", function() {
    expect(res.getBody().cobrosPendientes.length).to.equal(0);
  });
}
