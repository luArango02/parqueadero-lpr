meta {
  name: Calcular tarifa a las 05:59:59
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/cobros/calcular
  body: json
  auth: none
}

body:json {
  {
    "sedeId": "{{sedeId}}",
    "vehiculoId": "{{vehiculoId}}",
    "fechaIngreso": "2026-11-25T05:59:59-05:00"
  }
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Pertenece a franja nocturna", function() {
    expect(res.getBody().franja).to.equal("NOCTURNA");
  });

  test("Pertenece al dia operativo anterior", function() {
    expect(res.getBody().diaOperativo).to.equal("2026-11-24");
  });

  test("Valor nocturno correcto", function() {
    expect(Number(res.getBody().valor)).to.equal(5000);
  });
}
