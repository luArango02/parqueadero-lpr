meta {
  name: Calcular tarifa a las 06:00:00
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/cobros/calcular
  body: json
  auth: none
}

body:json {
  {
    "sedeId": "{{sedeId}}",
    "vehiculoId": "{{vehiculoId}}",
    "fechaIngreso": "2026-11-25T06:00:00-05:00"
  }
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Pertenece a franja diurna", function() {
    expect(res.getBody().franja).to.equal("DIURNA");
  });

  test("Inicia nuevo dia operativo", function() {
    expect(res.getBody().diaOperativo).to.equal("2026-11-25");
  });

  test("Valor diurno correcto", function() {
    expect(Number(res.getBody().valor)).to.equal(8000);
  });
}
