meta {
  name: Impedir validacion manual por administrador
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/detecciones/{{deteccionPendienteId}}/validacion
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "placa": "QZX124",
    "motivo": "Correccion manual de prueba PARQ-41"
  }
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:3001") {
    throw new Error("Ejecutar solo en el entorno aislado PARQ-41");
  }
}

tests {
  test("HTTP 403", function() {
    expect(res.getStatus()).to.equal(403);
  });

  test("Administrador sin permiso de validacion", function() {
    expect(res.getBody().statusCode).to.equal(403);
  });
}
