meta {
  name: Rechazar confianza fuera del rango permitido
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/detecciones
  body: json
  auth: none
}

body:json {
  {
    "placa": "QZX123",
    "confianza": 1.5,
    "tipoVisual": "CARRO"
  }
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:3001") {
    throw new Error("Ejecutar solo en el entorno aislado PARQ-41");
  }
}

tests {
  test("HTTP 400", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("Error de validacion", function() {
    expect(res.getBody().statusCode).to.equal(400);
    expect(res.getBody().message).to.be.an("array");
  });
}
