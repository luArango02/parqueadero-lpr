meta {
  name: Registrar carro de pruebas
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/vehiculos
  body: json
  auth: none
}

body:json {
  {
    "placa": "{{placaCarro}}",
    "tipo": "CARRO"
  }
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:3001") {
    throw new Error("Ejecutar solo en el entorno aislado PARQ-41");
  }
  const letras = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
  let prefijo = "";

  for (let i = 0; i < 3; i++) {
    prefijo += letras[Math.floor(Math.random() * 26)];
  }

  const numero = String(
    Math.floor(Math.random() * 1000)
  ).padStart(3, "0");

  bru.setVar("placaCarro", prefijo + numero);
  bru.setVar("referenciaPago", "PARQ41-" + Date.now());
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("vehiculoId", res.getBody().id);
  }
}

tests {
  test("HTTP 201", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("Placa registrada correctamente", function() {
    expect(res.getBody().placa)
      .to.equal(bru.getVar("placaCarro"));
  });

  test("Tipo CARRO", function() {
    expect(res.getBody().tipo).to.equal("CARRO");
  });

  test("Identificador disponible", function() {
    expect(res.getBody().id).to.be.a("string");
  });

  test("Sin permanencia activa inicial", function() {
    expect(res.getBody().permanenciaActiva).to.equal(null);
  });
}
