meta {
  name: Rechazar login de usuario inactivo
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{usuarioPruebaEmail}}",
    "password": "{{usuarioPruebaPassword}}"
  }
}

tests {
  test("HTTP 401", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("Usuario inactivo no recibe token", function() {
    expect(res.getBody())
      .not.to.have.property("accessToken");
  });
}