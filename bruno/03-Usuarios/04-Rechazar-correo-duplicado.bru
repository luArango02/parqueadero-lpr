meta {
  name: Rechazar correo duplicado
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/usuarios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "nombre": "Usuario duplicado PARQ-41",
    "email": "{{usuarioPruebaEmail}}",
    "password": "{{usuarioPruebaPassword}}",
    "rol": "OPERADOR"
  }
}

tests {
  test("HTTP 409", function() {
    expect(res.getStatus()).to.equal(409);
  });

  test("Conflicto de registro", function() {
    expect(res.getBody().statusCode).to.equal(409);
  });
}