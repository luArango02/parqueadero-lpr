meta {
  name: Denegar listado de usuarios al operador
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/usuarios
  body: none
  auth: bearer
}

auth:bearer {
  token: {{operadorToken}}
}

tests {
  test("HTTP 403", function() {
    expect(res.getStatus()).to.equal(403);
  });

  test("Permisos insuficientes", function() {
    expect(res.getBody().statusCode).to.equal(403);
  });
}