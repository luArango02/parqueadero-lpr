meta {
  name: Rechazar-modificacion-operador
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/api/tarifas/{{tarifaDiurnaInicialId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{operadorToken}}
}

body:json {
  {"valor":10000}
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:3001") {
    throw new Error("Ejecutar solo en el entorno aislado PARQ-41");
  }
}

tests {
  test("HTTP 403", function () {
      expect(res.getStatus()).to.equal(403);
  });

  test("Respuesta de error documentada", function () {
      const body = res.getBody();
      expect(body.statusCode).to.equal(403);
      expect(body).to.have.property("message");
      expect(body).to.have.property("path");
      expect(body).to.have.property("timestamp");
  });
}
