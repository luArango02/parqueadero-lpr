meta {
  name: Listar tarifas
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/tarifas?sedeId={{sedeId}}
  body: none
  auth: none
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Listado de tarifas disponible", function() {
    expect(res.getBody()).to.be.an("array");
    expect(res.getBody().length).to.be.greaterThan(0);
  });

  test("Tarifas pertenecen a la sede consultada", function() {
    res.getBody().forEach(tarifa => {
      expect(tarifa.sedeId).to.equal(
        bru.getVar("sedeId")
      );
    });
  });
}