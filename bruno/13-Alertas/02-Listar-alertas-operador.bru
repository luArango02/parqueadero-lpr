meta {
  name: Consultar alertas abiertas como operador
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/alertas?estado=ABIERTA&limite=100
  body: none
  auth: bearer
}

auth:bearer {
  token: {{operadorToken}}
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Respuesta de tipo arreglo", function() {
    expect(res.getBody()).to.be.an("array");
  });

  test("Filtro por estado aplicado", function() {
    expect(res.getBody().every(
      alerta => alerta.estado === "ABIERTA"
    )).to.equal(true);
  });

  test("Limite respetado", function() {
    expect(res.getBody().length).to.be.at.most(100);
  });
}
