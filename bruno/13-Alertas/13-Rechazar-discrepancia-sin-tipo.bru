meta {
  name: Exigir confirmacion del tipo de vehiculo
  type: http
  seq: 13
}

patch {
  url: {{baseUrl}}/api/alertas/{{alertaDiscrepanciaId}}/estado
  body: json
  auth: bearer
}

auth:bearer {
  token: {{operadorToken}}
}

body:json {
  {
    "estado": "RESUELTA",
    "resolucion": "Revision de clasificacion visual"
  }
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:3001") {
    throw new Error("Ejecutar solo en el entorno aislado PARQ-41");
  }
}

tests {
  test("HTTP 400", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("Confirmacion de tipo obligatoria", function() {
    expect(res.getBody().message)
      .to.include("Indique el tipo de vehículo");
  });
}
