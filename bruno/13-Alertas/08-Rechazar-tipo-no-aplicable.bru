meta {
  name: Rechazar tipo confirmado en anti-passback
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/api/alertas/{{alertaAntiPassbackId}}/estado
  body: json
  auth: bearer
}

auth:bearer {
  token: {{operadorToken}}
}

body:json {
  {
    "estado": "RESUELTA",
    "resolucion": "Revision de prueba PARQ-41",
    "tipoConfirmado": "CARRO"
  }
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:3001") {
    throw new Error("Ejecutar solo en el entorno aislado PARQ-41");
  }
}

tests {
  test("HTTP 400", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("Tipo confirmado no aplicable", function() {
    expect(res.getBody().message)
      .to.include("solo aplica a las discrepancias");
  });
}
