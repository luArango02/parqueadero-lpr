meta {
  name: Rechazar consulta de alertas sin autenticacion
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/alertas
  body: none
  auth: none
}

tests {
  test("HTTP 401", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("Autenticacion requerida", function() {
    expect(res.getBody().statusCode).to.equal(401);
  });
}
