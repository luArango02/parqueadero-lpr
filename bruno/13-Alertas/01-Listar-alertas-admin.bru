meta {
  name: Consultar alertas como administrador
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/alertas
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Respuesta de tipo arreglo", function() {
    expect(res.getBody()).to.be.an("array");
  });
}
