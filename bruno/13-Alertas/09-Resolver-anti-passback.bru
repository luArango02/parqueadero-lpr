meta {
  name: Resolver alerta anti-passback como operador
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/api/alertas/{{alertaAntiPassbackId}}/estado
  body: json
  auth: bearer
}

auth:bearer {
  token: {{operadorToken}}
}

body:json {
  {
    "estado": "RESUELTA",
    "resolucion": "Ingreso duplicado revisado por operador PARQ-41"
  }
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:3001") {
    throw new Error("Ejecutar solo en el entorno aislado PARQ-41");
  }
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Identificador conservado", function() {
    expect(res.getBody().id)
      .to.equal(bru.getVar("alertaAntiPassbackId"));
  });

  test("Estado RESUELTA", function() {
    expect(res.getBody().estado).to.equal("RESUELTA");
  });

  test("Tipo original conservado", function() {
    expect(res.getBody().tipo).to.equal("ANTI_PASSBACK");
  });

  test("Operador responsable registrado", function() {
    expect(res.getBody().resueltaPor.id)
      .to.equal(bru.getVar("operadorId"));
  });

  test("Fecha de resolucion registrada", function() {
    expect(res.getBody().resueltaEn).to.be.a("string");
  });

  test("Motivo conservado", function() {
    expect(res.getBody().resolucion)
      .to.equal("Ingreso duplicado revisado por operador PARQ-41");
  });
}
