meta {
  name: Reingresar con pase vigente
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/accesos/ingreso
  body: json
  auth: none
}

body:json {
  {
    "placa": "{{placaCarro}}",
    "confianza": 0.98,
    "carrilId": "{{carrilEntradaId}}"
  }
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:3001") {
    throw new Error("Ejecutar solo en el entorno aislado PARQ-41");
  }
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Reingreso autorizado", function() {
    expect(res.getBody().autorizado).to.equal(true);
  });

  test("Identificado como reingreso", function() {
    expect(res.getBody().reingreso).to.equal(true);
  });

  test("No se genera un nuevo cobro", function() {
    expect(res.getBody().cobro.id)
      .to.equal(bru.getVar("cobroId"));
  });

  test("Cobro conserva estado PAGADO", function() {
    expect(res.getBody().cobro.estado).to.equal("PAGADO");
  });

  test("Valor original conservado", function() {
    expect(Number(res.getBody().cobro.valor))
      .to.equal(Number(bru.getVar("valorCobro")));
  });

  test("Espacio asignado", function() {
    expect(res.getBody().espacio).to.be.a("string");
  });
}
