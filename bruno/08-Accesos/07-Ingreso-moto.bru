meta {
  name: Registrar ingreso de motocicleta exenta
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/accesos/ingreso
  body: json
  auth: none
}

body:json {
  {
    "placa": "{{placaMoto}}",
    "confianza": 0.98,
    "carrilId": "{{carrilEntradaId}}"
  }
}

script:pre-request {
  if (bru.getEnvVar("baseUrl") !== "http://localhost:3001") {
    throw new Error("Ejecutar solo en el entorno aislado PARQ-41");
  }
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Ingreso autorizado", function() {
    expect(res.getBody().autorizado).to.equal(true);
  });

  test("Barrera abierta", function() {
    expect(res.getBody().barrera).to.equal("ABIERTA");
  });

  test("Tipo MOTO", function() {
    expect(res.getBody().tipoVehiculo).to.equal("MOTO");
  });

  test("Espacio asignado", function() {
    expect(res.getBody().espacio).to.be.a("string");
  });

  test("No se genera cobro", function() {
    expect(res.getBody().cobro).to.equal(null);
  });

  test("Primer ingreso", function() {
    expect(res.getBody().reingreso).to.equal(false);
  });
}
