meta {
  name: Rechazar limite superior
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/eventos/recientes?limite=51
  body: none
  auth: none
}

tests {
  test("HTTP 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("Respuesta de error documentada", function () {
    expect(res.getBody().statusCode).to.equal(400);
    expect(res.getBody()).to.have.property("message");
  });
}
