meta {
  name: Filtrar-placa-parcial
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/api/eventos/historial?placa={{placaParcial}}&limite=100
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

script:pre-request {
  bru.setVar(
    "placaParcial",
    bru.getVar("placaHistorial").substring(0, 3).toLowerCase()
  );
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Filtro aplicado correctamente", function () {
    const body = res.getBody();
    expect(body.datos).to.be.an("array");
    expect(body.datos.length).to.be.greaterThan(0);

  const parcial = bru.getVar("placaParcial").toUpperCase();

  expect(body.total).to.be.greaterThan(0);

  body.datos.forEach(function (e) {
    expect(e.placa.toUpperCase()).to.include(parcial);
  });
  });
}
