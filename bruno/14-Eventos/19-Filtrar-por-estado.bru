meta {
  name: Filtrar-por-estado
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/api/eventos/historial?estado=DENEGADO
  body: none
  auth: bearer
}

auth:bearer {
  token: {{operadorToken}}
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Filtro aplicado correctamente", function () {
    const body = res.getBody();
    expect(body.datos).to.be.an("array");
    expect(body.datos.length).to.be.greaterThan(0);

  expect(body.total).to.be.greaterThan(0);

  body.datos.forEach(function (e) {
    expect(e.estado).to.equal("DENEGADO");
    expect(["INGRESO_DENEGADO", "SALIDA_DENEGADA"])
      .to.include(e.tipo);
  });
  });
}
