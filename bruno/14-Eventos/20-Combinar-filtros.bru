meta {
  name: Combinar-filtros
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/api/eventos/historial?placa={{placaHistorial}}&tipo=PAGO&estado=PAGADO
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Filtro aplicado correctamente", function () {
    const body = res.getBody();
    expect(body.datos).to.be.an("array");
    expect(body.datos.length).to.be.greaterThan(0);

  expect(body.total).to.be.greaterThan(0);

  body.datos.forEach(function (e) {
    expect(e.placa).to.equal(bru.getVar("placaHistorial"));
    expect(e.tipo).to.equal("PAGO");
    expect(e.estado).to.equal("PAGADO");
  });
  });
}
