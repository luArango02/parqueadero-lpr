meta {
  name: Filtrar-fechas-inclusivas
  type: http
  seq: 21
}

get {
  url: {{baseUrl}}/api/eventos/historial?tipo=PAGO&desde={{fechaEventoPago}}&hasta={{fechaEventoPago}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Filtro aplicado correctamente", function () {
    const body = res.getBody();
    expect(body.datos).to.be.an("array");
    expect(body.datos.length).to.be.greaterThan(0);

  const fecha = Date.parse(bru.getVar("fechaEventoPago"));

  expect(body.total).to.be.greaterThan(0);

  body.datos.forEach(function (e) {
    expect(e.tipo).to.equal("PAGO");
    expect(Date.parse(e.ocurridoEn)).to.equal(fecha);
  });
  });
}
