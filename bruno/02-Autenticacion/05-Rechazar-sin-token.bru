meta {
  name: Rechazar perfil sin autenticacion
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/auth/profile
  body: none
  auth: none
}

tests {
  test("HTTP 401", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("Error de autenticacion", function() {
    expect(res.getBody().statusCode).to.equal(401);
  });
}