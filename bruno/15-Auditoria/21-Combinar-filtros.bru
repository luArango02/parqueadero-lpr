meta {
  name: Combinar-filtros
  type: http
  seq: 21
}

get {
  url: {{baseUrl}}/api/auditoria?usuarioId={{auditoriaUsuarioId}}&accion={{auditoriaAccion}}&entidad={{auditoriaEntidad}}&entidadId={{auditoriaEntidadId}}&limite=100
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Filtro aplicado correctamente", function () {
    const body = res.getBody();

    expect(body.datos).to.be.an("array");
    expect(body.datos.length).to.be.greaterThan(0);
    expect(body.total).to.be.greaterThan(0);

  body.datos.forEach(function (e) {
    expect(e.usuarioId)
      .to.equal(bru.getVar("auditoriaUsuarioId"));

    expect(e.accion)
      .to.equal(bru.getVar("auditoriaAccion"));

    expect(e.entidad)
      .to.equal(bru.getVar("auditoriaEntidad"));

    expect(e.entidadId)
      .to.equal(bru.getVar("auditoriaEntidadId"));
  });

  expect(body.datos.some(function (e) {
    return e.id === bru.getVar("auditoriaRegistroId");
  })).to.equal(true);
  });
}
