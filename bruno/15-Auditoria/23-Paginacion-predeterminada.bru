meta {
  name: Paginacion predeterminada auditoria
  type: http
  seq: 23
}

get {
  url: {{baseUrl}}/api/auditoria
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Valores predeterminados correctos", function () {
    const body = res.getBody();

    expect(body.pagina).to.equal(1);
    expect(body.limite).to.equal(20);
    expect(body.total).to.equal(
      Number(bru.getVar("totalAuditoria"))
    );
    expect(body.datos.length)
      .to.equal(Math.min(body.total, 20));
    expect(body.totalPaginas)
      .to.equal(Math.ceil(body.total / 20));
  });
}
