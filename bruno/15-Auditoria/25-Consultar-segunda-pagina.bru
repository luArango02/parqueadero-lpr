meta {
  name: Consultar segunda pagina auditoria
  type: http
  seq: 25
}

get {
  url: {{baseUrl}}/api/auditoria?pagina=2&limite=2
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Segunda pagina consistente", function () {
    const body = res.getBody();

    expect(body.pagina).to.equal(2);
    expect(body.limite).to.equal(2);
    expect(body.datos.length).to.equal(2);
    expect(body.total).to.equal(
      Number(bru.getVar("totalAuditoria"))
    );
  });

  test("No repite registros de la primera pagina", function () {
    const anteriores = JSON.parse(
      bru.getVar("idsAuditoriaPrimeraPagina")
    );

    res.getBody().datos.forEach(function (e) {
      expect(anteriores).not.to.include(e.id);
    });
  });
}
