meta {
  name: Estado del servicio
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/health
  body: none
  auth: none
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Servicio disponible", function() {
    expect(res.getBody().status).to.equal("ok");
  });

  test("Conexion PostgreSQL disponible", function() {
    expect(res.getBody().database).to.equal("ok");
  });

  test("Nombre del servicio correcto", function() {
    expect(res.getBody().service)
      .to.equal("parqueadero-lpr-backend");
  });
}

docs {
  Verifica la disponibilidad del backend y su conexion
  con PostgreSQL.
}