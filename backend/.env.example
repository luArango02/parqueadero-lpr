# Para ejecutar el backend fuera de Docker (npm run start:dev). Copiar como .env.
# Usuario y clave de DATABASE_URL deben coincidir con los del .env de la raíz.

PORT=3000
TZ_SEDE=America/Bogota
DATABASE_URL=postgresql://parqueadero:cambiar-esta-clave@localhost:5432/parqueadero
JWT_SECRET=cambiar-por-un-valor-secreto-largo
JWT_EXPIRES_IN=8h
