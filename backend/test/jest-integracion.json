{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".integracion-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "globalSetup": "<rootDir>/integracion/preparar-base.ts",
  "setupFiles": ["<rootDir>/integracion/entorno-pruebas.ts"],
  "maxWorkers": 1,
  "testTimeout": 30000
}
