// Las fechas se guardan en UTC (timestamptz) y se convierten a la hora de la sede.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMINISTRADOR
  OPERADOR
}

enum TipoVehiculo {
  CARRO
  MOTO
}

enum SentidoCarril {
  ENTRADA
  SALIDA
}

enum EstadoEspacio {
  DISPONIBLE
  OCUPADO
  FUERA_DE_SERVICIO
}

enum Franja {
  DIURNA
  NOCTURNA
}

enum EstadoCobro {
  PENDIENTE
  PAGADO
  ANULADO
  VENCIDO
}

enum MedioPago {
  EFECTIVO
  TARJETA
  PSE
  NEQUI
}

enum EstadoDeteccion {
  ACEPTADA
  PENDIENTE_REVISION
  CORREGIDA
}

enum TipoEvento {
  INGRESO
  SALIDA
  INGRESO_DENEGADO
  SALIDA_DENEGADA
}

enum TipoAlerta {
  ANTI_PASSBACK
  DISCREPANCIA_TIPO
  BAJA_CONFIANZA
  FALLA_CAMARA
}

enum EstadoAlerta {
  ABIERTA
  RESUELTA
}

model Usuario {
  id           String   @id @default(uuid())
  nombre       String
  email        String   @unique
  passwordHash String   @map("password_hash")
  rol          Rol
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  auditorias            Auditoria[]
  deteccionesCorregidas Deteccion[] @relation("DeteccionCorregidaPor")
  alertasResueltas      Alerta[]    @relation("AlertaResueltaPor")
  pagosRegistrados      Pago[]

  @@map("usuarios")
}

model Sede {
  id                   String @id @default(uuid())
  nombre               String @unique
  zonaHoraria          String @default("America/Bogota") @map("zona_horaria")
  // Horas locales "HH:mm": son configuración, no constantes en el código.
  inicioDiaOperativo   String @default("06:00") @map("inicio_dia_operativo")
  inicioFranjaDiurna   String @default("06:00") @map("inicio_franja_diurna")
  inicioFranjaNocturna String @default("18:00") @map("inicio_franja_nocturna")
  umbralConfianza      Float  @default(0.8) @map("umbral_confianza")

  carriles Carril[]
  espacios Espacio[]
  tarifas  Tarifa[]
  eventos  EventoAcceso[]
  cobros   Cobro[]
  alertas  Alerta[]

  @@map("sedes")
}

model Carril {
  id      String        @id @default(uuid())
  sedeId  String        @map("sede_id")
  nombre  String
  sentido SentidoCarril

  sede        Sede           @relation(fields: [sedeId], references: [id])
  detecciones Deteccion[]
  eventos     EventoAcceso[]

  @@unique([sedeId, nombre])
  @@map("carriles")
}

model Espacio {
  id             String        @id @default(uuid())
  sedeId         String        @map("sede_id")
  codigo         String
  zona           String
  tipoCompatible TipoVehiculo  @map("tipo_compatible")
  estado         EstadoEspacio @default(DISPONIBLE)

  sede         Sede           @relation(fields: [sedeId], references: [id])
  permanencias Permanencia[]  @relation("PermanenciaEspacio")
  eventos      EventoAcceso[]

  @@unique([sedeId, codigo])
  @@map("espacios")
}

model Vehiculo {
  id       String       @id @default(uuid())
  placa    String       @unique
  tipo     TipoVehiculo
  creadoEn DateTime     @default(now()) @map("creado_en") @db.Timestamptz(3)

  permanencias Permanencia[]  @relation("PermanenciaVehiculo")
  eventos      EventoAcceso[]
  cobros       Cobro[]

  @@map("vehiculos")
}

model Deteccion {
  id               String          @id @default(uuid())
  carrilId         String          @map("carril_id")
  placaLeida       String          @map("placa_leida")
  // La leída si se aceptó, o la corregida por el operador (se conserva la original).
  placaFinal       String?         @map("placa_final")
  confianza        Float
  tipoVisual       TipoVehiculo?   @map("tipo_visual")
  estado           EstadoDeteccion
  lecturaManual    Boolean         @default(false) @map("lectura_manual")
  corregidaPorId   String?         @map("corregida_por_id")
  motivoCorreccion String?         @map("motivo_correccion")
  fotoUrl          String?         @map("foto_url")
  ocurridaEn       DateTime        @default(now()) @map("ocurrida_en") @db.Timestamptz(3)

  carril       Carril         @relation(fields: [carrilId], references: [id])
  corregidaPor Usuario?       @relation("DeteccionCorregidaPor", fields: [corregidaPorId], references: [id])
  eventos      EventoAcceso[]
  alertas      Alerta[]

  @@index([placaLeida])
  @@map("detecciones")
}

model EventoAcceso {
  id          String     @id @default(uuid())
  sedeId      String     @map("sede_id")
  carrilId    String     @map("carril_id")
  placa       String
  vehiculoId  String?    @map("vehiculo_id")
  tipo        TipoEvento
  motivo      String?
  espacioId   String?    @map("espacio_id")
  deteccionId String?    @map("deteccion_id")
  ocurridoEn  DateTime   @default(now()) @map("ocurrido_en") @db.Timestamptz(3)

  sede      Sede       @relation(fields: [sedeId], references: [id])
  carril    Carril     @relation(fields: [carrilId], references: [id])
  vehiculo  Vehiculo?  @relation(fields: [vehiculoId], references: [id])
  espacio   Espacio?   @relation(fields: [espacioId], references: [id])
  deteccion Deteccion? @relation(fields: [deteccionId], references: [id])

  permanenciaIngreso Permanencia? @relation("PermanenciaIngreso")
  permanenciaSalida  Permanencia? @relation("PermanenciaSalida")

  @@index([placa, ocurridoEn])
  @@map("eventos_acceso")
}

model Permanencia {
  id               String    @id @default(uuid())
  vehiculoId       String    @map("vehiculo_id")
  espacioId        String    @map("espacio_id")
  eventoIngresoId  String    @unique @map("evento_ingreso_id")
  eventoSalidaId   String?   @unique @map("evento_salida_id")
  ingresoEn        DateTime  @map("ingreso_en") @db.Timestamptz(3)
  salidaEn         DateTime? @map("salida_en") @db.Timestamptz(3)
  // Copian vehiculoId y espacioId mientras la permanencia está activa y pasan a null al cerrarla.
  // Al ser únicos, la base de datos impide dos permanencias activas del mismo vehículo o espacio.
  vehiculoActivoId String?   @unique @map("vehiculo_activo_id")
  espacioActivoId  String?   @unique @map("espacio_activo_id")

  vehiculo      Vehiculo      @relation("PermanenciaVehiculo", fields: [vehiculoId], references: [id])
  espacio       Espacio       @relation("PermanenciaEspacio", fields: [espacioId], references: [id])
  eventoIngreso EventoAcceso  @relation("PermanenciaIngreso", fields: [eventoIngresoId], references: [id])
  eventoSalida  EventoAcceso? @relation("PermanenciaSalida", fields: [eventoSalidaId], references: [id])

  @@map("permanencias")
}

model Tarifa {
  id           String       @id @default(uuid())
  sedeId       String       @map("sede_id")
  tipoVehiculo TipoVehiculo @map("tipo_vehiculo")
  franja       Franja
  // Moto = 0: no se genera cobro (RN-01) sin poner una excepción en el código.
  valor        Decimal      @db.Decimal(12, 2)
  version      Int
  vigenteDesde DateTime     @map("vigente_desde") @db.Timestamptz(3)
  vigenteHasta DateTime?    @map("vigente_hasta") @db.Timestamptz(3)

  sede   Sede    @relation(fields: [sedeId], references: [id])
  cobros Cobro[]

  @@unique([sedeId, tipoVehiculo, franja, version])
  @@map("tarifas")
}

model Cobro {
  id           String      @id @default(uuid())
  sedeId       String      @map("sede_id")
  vehiculoId   String      @map("vehiculo_id")
  placa        String
  // Fecha local del día operativo (06:00 a 05:59).
  diaOperativo DateTime    @map("dia_operativo") @db.Date
  franja       Franja
  tarifaId     String      @map("tarifa_id")
  // Se copia para que un cambio de tarifa no altere cobros ya generados (RN-07).
  valor        Decimal     @db.Decimal(12, 2)
  estado       EstadoCobro @default(PENDIENTE)
  generadoEn   DateTime    @default(now()) @map("generado_en") @db.Timestamptz(3)

  sede     Sede     @relation(fields: [sedeId], references: [id])
  vehiculo Vehiculo @relation(fields: [vehiculoId], references: [id])
  tarifa   Tarifa   @relation(fields: [tarifaId], references: [id])
  pago     Pago?

  // RN-04 garantizado por la base de datos, no solo por el código.
  @@unique([placa, sedeId, diaOperativo])
  @@map("cobros")
}

model Pago {
  id              String    @id @default(uuid())
  cobroId         String    @unique @map("cobro_id")
  medio           MedioPago
  valor           Decimal   @db.Decimal(12, 2)
  // Única para que un pago repetido no se registre dos veces (idempotencia).
  referencia      String    @unique
  registradoPorId String?   @map("registrado_por_id")
  pagadoEn        DateTime  @default(now()) @map("pagado_en") @db.Timestamptz(3)

  cobro         Cobro    @relation(fields: [cobroId], references: [id])
  registradoPor Usuario? @relation(fields: [registradoPorId], references: [id])

  @@map("pagos")
}

model Alerta {
  id            String       @id @default(uuid())
  sedeId        String       @map("sede_id")
  tipo          TipoAlerta
  estado        EstadoAlerta @default(ABIERTA)
  placa         String?
  detalle       String
  deteccionId   String?      @map("deteccion_id")
  resueltaPorId String?      @map("resuelta_por_id")
  resolucion    String?
  creadaEn      DateTime     @default(now()) @map("creada_en") @db.Timestamptz(3)
  resueltaEn    DateTime?    @map("resuelta_en") @db.Timestamptz(3)

  sede        Sede       @relation(fields: [sedeId], references: [id])
  deteccion   Deteccion? @relation(fields: [deteccionId], references: [id])
  resueltaPor Usuario?   @relation("AlertaResueltaPor", fields: [resueltaPorId], references: [id])

  @@index([estado])
  @@map("alertas")
}

model Auditoria {
  id              String   @id @default(uuid())
  usuarioId       String?  @map("usuario_id")
  accion          String
  entidad         String
  entidadId       String?  @map("entidad_id")
  datosAnteriores Json?    @map("datos_anteriores")
  datosNuevos     Json?    @map("datos_nuevos")
  ocurridaEn      DateTime @default(now()) @map("ocurrida_en") @db.Timestamptz(3)

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([entidad, entidadId])
  @@map("auditoria")
}
