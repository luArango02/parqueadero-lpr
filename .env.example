# Variables para Docker Compose y el backend.
# Copie este archivo como .env y ponga sus propios valores. El .env nunca se sube.

# Backend
PORT=3000
TZ_SEDE=America/Bogota

# Base de datos (se usa a partir de ACT-004 y ACT-005)
POSTGRES_USER=parqueadero
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=parqueadero
DATABASE_URL=postgresql://parqueadero:cambiar-esta-clave@localhost:5432/parqueadero

# Autenticación (se usa a partir de ACT-006)
JWT_SECRET=cambiar-por-un-valor-secreto-largo
JWT_EXPIRES_IN=8h
