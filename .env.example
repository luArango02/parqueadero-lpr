# Plantilla: copiar como .env y poner valores propios. El .env no se sube al repositorio.

PORT=3000
TZ_SEDE=America/Bogota

POSTGRES_USER=parqueadero
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=parqueadero
DATABASE_URL=postgresql://parqueadero:cambiar-esta-clave@localhost:5432/parqueadero

JWT_SECRET=cambiar-por-un-valor-secreto-largo
JWT_EXPIRES_IN=8h
